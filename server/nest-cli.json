{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "defaultProject": "api-gatway",
  "sourceRoot": "apps/api-gatway/src",
  "root": "apps/api-gatway",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "apps/api-gatway/tsconfig.app.json",
    "builder": "rspack"
  },
  "projects": {
    "api-gatway": {
      "type": "application",
      "root": "apps/api-gatway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gatway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gatway/tsconfig.app.json"
      }
    },
    "cache": {
      "type": "library",
      "root": "libs/cache",
      "entryFile": "index",
      "sourceRoot": "libs/cache/src",
      "compilerOptions": {
        "tsConfigPath": "libs/cache/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "configuration": {
      "type": "library",
      "root": "libs/configuration",
      "entryFile": "index",
      "sourceRoot": "libs/configuration/src",
      "compilerOptions": {
        "tsConfigPath": "libs/configuration/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "engineering-service": {
      "type": "application",
      "root": "apps/engineering-service",
      "entryFile": "main",
      "sourceRoot": "apps/engineering-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/engineering-service/tsconfig.app.json"
      }
    },
    "error": {
      "type": "library",
      "root": "libs/error",
      "entryFile": "index",
      "sourceRoot": "libs/error/src",
      "compilerOptions": {
        "tsConfigPath": "libs/error/tsconfig.lib.json"
      }
    },
    "grpc": {
      "type": "library",
      "root": "libs/grpc",
      "entryFile": "index",
      "sourceRoot": "libs/grpc/src",
      "compilerOptions": {
        "tsConfigPath": "libs/grpc/tsconfig.lib.json"
      }
    },
    "identity-service": {
      "type": "application",
      "root": "apps/identity-service",
      "entryFile": "main",
      "sourceRoot": "apps/identity-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/identity-service/tsconfig.app.json"
      }
    },
    "intelligence-service": {
      "type": "application",
      "root": "apps/intelligence-service",
      "entryFile": "main",
      "sourceRoot": "apps/intelligence-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/intelligence-service/tsconfig.app.json"
      }
    },
    "platform-service": {
      "type": "application",
      "root": "apps/platform-service",
      "entryFile": "main",
      "sourceRoot": "apps/platform-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/platform-service/tsconfig.app.json"
      }
    },
    "work-service": {
      "type": "application",
      "root": "apps/work-service",
      "entryFile": "main",
      "sourceRoot": "apps/work-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/work-service/tsconfig.app.json"
      }
    }
  }
}