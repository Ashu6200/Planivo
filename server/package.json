{
  "name": "server",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "start": "nest start",
    "start:dev": "npm run start:dev:all",
    "start:dev:all": "concurrently -c \"blue,green,yellow,magenta,cyan,red\" -n \"gateway,identity,work,engineering,platform,intelligence\" \"npm run start:dev:gateway\" \"npm run start:dev:identity\" \"npm run start:dev:work\" \"npm run start:dev:engineering\" \"npm run start:dev:platform\" \"npm run start:dev:intelligence\"",
    "start:dev:single": "nest start --watch",
    "start:dev:gateway": "nest start api-gatway --watch",
    "start:dev:identity": "nest start identity-service --watch",
    "start:dev:work": "nest start work-service --watch",
    "start:dev:engineering": "nest start engineering-service --watch",
    "start:dev:platform": "nest start platform-service --watch",
    "start:dev:intelligence": "nest start intelligence-service --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/api-gatway/main",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@rspack/core": "^2.2.8",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "concurrently": "^10.0.5",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2",
    "webpack-node-externals": "^3.0.0"
  }
}
